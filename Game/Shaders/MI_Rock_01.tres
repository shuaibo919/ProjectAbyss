[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_b81aorbbbnsl8"]
size = Vector2(980, 540)
expression = "//Transform:39(FuzzyShading)
vec3 WorldTangent  = ( INV_VIEW_MATRIX * vec4( TANGENT, 0.0)).xyz;
vec3 WorldBinormal = ( INV_VIEW_MATRIX * vec4( BINORMAL, 0.0)).xyz;
vec3 WorldNormal   = ( INV_VIEW_MATRIX * vec4( NORMAL, 0.0)).xyz;
