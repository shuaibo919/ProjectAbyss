#version 450

// SlowTree Stage 2: 枝领裙边展开。invocation = 一条裙边。
// 与 TreeGenerator::appendCollar 逐行对应; weldSegs=4 常量与 CPU 一致。
// 分支顶点 stride = 10: pos(3) normal(3) uv(2) wind(2)
// 描述子的 childDir/childRight/parentA 均为 CPU 归一化后的值(不二次归一化)。

layout(local_size_x = 1) in;

struct CollarDesc {
    vec4 parentCandR;   // parentC.xyz, parentR
    vec4 parentA;       // 归一化轴向
    vec4 childBase;
    vec4 childDir;      // 归一化
    vec4 childRight;
    vec4 shape;         // startR, flareMax, upperSpread, lowerSpread
    vec4 shape2;        // landingR, uTiling, vPerUnit, collarSink
    vec4 meta;          // sides, ringOffset, ringCount, windPhase
    vec4 meta2;         // firstVertexFloats, firstVertexUnits, firstIdx, 0
};

struct RingEntry { vec4 centerRadius; vec4 right; vec4 up; };

layout(std430, set = 0, binding = 0) readonly buffer DescBuf { CollarDesc descs[]; };
layout(std430, set = 0, binding = 1) readonly buffer RingBuf { RingEntry rings[]; };
layout(std430, set = 0, binding = 2) buffer VertBuf { float verts[]; };
layout(std430, set = 0, binding = 3) buffer IdxBuf { uint indices[]; };

const float TWO_PI = 6.28318530718;
const int STRIDE = 10;
const int WELD_SEGS = 4;

float smooth01(float x) {
    x = clamp(x, 0.0, 1.0);
    return x * x * (3.0 - 2.0 * x);
}

// 落点半径: 沿树干环列按轴向线性插值(与 CPU landingAt 一致)。
float landingAt(CollarDesc d, float axial) {
    if (int(d.meta.z) < 2) return d.shape2.x;
    int ringOff = int(d.meta.y);
    int ringCount = int(d.meta.z);
    float a0 = dot(rings[ringOff].centerRadius.xyz - d.parentCandR.xyz, d.parentA.xyz);
    for (int i = 1; i < ringCount; ++i) {
        float a1 = dot(rings[ringOff + i].centerRadius.xyz - d.parentCandR.xyz, d.parentA.xyz);
        if (axial <= a1 || i + 1 == ringCount) {
            float denom = a1 - a0;
            float f = (abs(denom) > 1e-5) ? (axial - a0) / denom : 0.0;
            f = clamp(f, 0.0, 1.0);
            return mix(rings[ringOff + i - 1].centerRadius.w,
                       rings[ringOff + i].centerRadius.w, f) * 0.99;
        }
        a0 = a1;
    }
    return d.shape2.x;
}

void main() {
    uint ci = gl_GlobalInvocationID.x;
    if (ci >= descs.length()) return;
    CollarDesc d = descs[ci];
    int sides = int(d.meta.x);
    vec3 up = d.childDir.xyz;              // CPU 已归一化
    vec3 fwd = normalize(cross(up, d.childRight.xyz));
    uint vertBase = uint(d.meta2.y);   // 索引用: 全局顶点单位
    uint idxBase = uint(d.meta2.z);
    uint writeBase = uint(d.meta2.x);  // 顶点写偏移: 全局 float 缓冲内的起点
    int rv = sides + 1;

    for (int k = 0; k <= WELD_SEGS; ++k) {
        float u = float(k) / float(WELD_SEGS);
        float su = smooth01(u);
        float R = d.shape.x + d.shape.y * su;
        float proj = su;
        for (int j = 0; j <= sides; ++j) {
            float a = float(j) / float(sides) * TWO_PI;
            vec3 localDir = d.childRight.xyz * cos(a) + fwd * sin(a);
            vec3 p = d.childBase.xyz + localDir * R;

            vec3 v = p - d.parentCandR.xyz;
            float axialRaw = dot(v, d.parentA.xyz);
            float s = dot(localDir, d.parentA.xyz);
            float axial = axialRaw + (s >= 0.0 ? d.shape.z : d.shape.w) * s;
            vec3 radial = v - d.parentA.xyz * axialRaw;
            float rl = length(radial);
            vec3 rdir = (rl > 1e-5) ? radial / rl : localDir;
            float landR = landingAt(d, axial) * (1.0 - d.shape2.w * su);
            vec3 onTrunk = d.parentCandR.xyz + d.parentA.xyz * axial + rdir * landR;

            vec3 pos = mix(p, onTrunk, proj);
            vec3 normal = normalize(mix(localDir, rdir, proj));
            float vCoord = -length(pos - (d.childBase.xyz + localDir * d.shape.x)) * d.shape2.z;
            float uCoord = float(j) / float(sides) * d.shape2.y;

            uint o = writeBase + uint(k * rv + j) * STRIDE;
            verts[o+0] = pos.x; verts[o+1] = pos.y; verts[o+2] = pos.z;
            verts[o+3] = normal.x; verts[o+4] = normal.y; verts[o+5] = normal.z;
            verts[o+6] = uCoord; verts[o+7] = vCoord;
            verts[o+8] = 0.0; verts[o+9] = d.meta.w;
        }
    }
    // k=0 圈(枝条基部) → k=WELD_SEGS 圈(父级表面), 绕序与 CPU 一致(相对圆柱翻转)
    for (int k = 0; k < WELD_SEGS; ++k) {
        for (int j = 0; j < sides; ++j) {
            uint a0 = vertBase + uint(k * rv + j);
            uint a1 = a0 + 1u;
            uint b0 = vertBase + uint((k + 1) * rv + j);
            uint b1 = b0 + 1u;
            uint o = idxBase + uint(k * sides + j) * 6u;
            indices[o+0] = a0; indices[o+1] = b0; indices[o+2] = a1;
            indices[o+3] = a1; indices[o+4] = b0; indices[o+5] = b1;
        }
    }
}
