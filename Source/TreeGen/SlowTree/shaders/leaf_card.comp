#version 450

// SlowTree Stage 2: 叶卡展开。invocation = 一片叶。
// 与 TreeGenerator::buildLeafCluster 逐行对应; 无 GPU 三角函数(所有值 CPU 已算好)。
// 叶顶点 stride = 16: pos(3) normal(3) uv(2) albedo(3) wind(2) anchor(3)

layout(local_size_x = 1) in;

struct LeafCardDesc {
    vec4 pos;         // 叶心
    vec4 leafRight;
    vec4 leafUp;
    vec4 leafNormal;
    vec4 size;        // hs, hw, windW, leafPhase
    vec4 albedo;
    vec4 anchor;      // basePos(绕其摆动)
    vec4 meta;        // mode(0=quad,1=cutout), pointOff, triOff, triCount
    vec4 meta2;       // pointCount, firstVertexFloats, firstVertexUnits, firstIdx
};

layout(std430, set = 0, binding = 0) readonly buffer DescBuf { LeafCardDesc descs[]; };
layout(std430, set = 0, binding = 1) readonly buffer PointBuf { vec2 points[]; };
layout(std430, set = 0, binding = 2) readonly buffer TriBuf { uint tris[]; };
layout(std430, set = 0, binding = 3) buffer VertBuf { float verts[]; };
layout(std430, set = 0, binding = 4) buffer IdxBuf { uint indices[]; };

const int STRIDE = 16;

void main() {
    uint li = gl_GlobalInvocationID.x;
    if (li >= descs.length()) return;
    LeafCardDesc d = descs[li];
    uint vertBase = uint(d.meta2.z);   // 索引用: 全局顶点单位
    uint idxBase = uint(d.meta2.w);
    uint writeBase = uint(d.meta2.y);  // 顶点写偏移: 全局 float 缓冲内的起点

    if (d.meta.x > 0.5) {
        // 轮廓网格: UV 点(u,v) 映射到叶卡平面(与 CPU 一致)
        uint pointCount = uint(d.meta2.x);
        uint pointOff = uint(d.meta.y);
        for (uint i = 0u; i < pointCount; ++i) {
            vec2 q = points[pointOff + i];
            vec3 wp = d.pos.xyz + d.leafRight.xyz * ((q.x - 0.5) * 2.0 * d.size.y)
                                 + d.leafUp.xyz    * ((q.y - 0.5) * 2.0 * d.size.x);
            uint o = writeBase + i * STRIDE;
            verts[o+0] = wp.x; verts[o+1] = wp.y; verts[o+2] = wp.z;
            verts[o+3] = d.leafNormal.x; verts[o+4] = d.leafNormal.y; verts[o+5] = d.leafNormal.z;
            verts[o+6] = q.x; verts[o+7] = q.y;
            verts[o+8] = d.albedo.x; verts[o+9] = d.albedo.y; verts[o+10] = d.albedo.z;
            verts[o+11] = d.size.z; verts[o+12] = d.size.w;
            verts[o+13] = d.anchor.x; verts[o+14] = d.anchor.y; verts[o+15] = d.anchor.z;
        }
        // 与 CPU 一致的合法三角形过滤(k+2 < triCount, 顶点全部 < pointCount)
        uint triOff = uint(d.meta.z);
        uint triCount = uint(d.meta.w);
        uint w = idxBase;
        for (uint k = 0u; k + 2u < triCount; k += 3u) {
            uint a = tris[triOff + k], b = tris[triOff + k + 1u], c = tris[triOff + k + 2u];
            if (a < pointCount && b < pointCount && c < pointCount) {
                indices[w+0u] = vertBase + a;
                indices[w+1u] = vertBase + b;
                indices[w+2u] = vertBase + c;
                w += 3u;
            }
        }
    } else {
        // quad: 左下(0,0) 右下(1,0) 右上(1,1) 左上(0,1)
        for (uint i = 0u; i < 4u; ++i) {
            float su = (i == 1u || i == 2u) ? 1.0 : 0.0;
            float sv = (i >= 2u) ? 1.0 : 0.0;
            vec3 wp = d.pos.xyz + d.leafRight.xyz * ((su - 0.5) * 2.0 * d.size.y)
                                 + d.leafUp.xyz    * ((sv - 0.5) * 2.0 * d.size.x);
            uint o = writeBase + i * STRIDE;
            verts[o+0] = wp.x; verts[o+1] = wp.y; verts[o+2] = wp.z;
            verts[o+3] = d.leafNormal.x; verts[o+4] = d.leafNormal.y; verts[o+5] = d.leafNormal.z;
            verts[o+6] = su; verts[o+7] = sv;
            verts[o+8] = d.albedo.x; verts[o+9] = d.albedo.y; verts[o+10] = d.albedo.z;
            verts[o+11] = d.size.z; verts[o+12] = d.size.w;
            verts[o+13] = d.anchor.x; verts[o+14] = d.anchor.y; verts[o+15] = d.anchor.z;
        }
        indices[idxBase+0u] = vertBase;
        indices[idxBase+1u] = vertBase + 1u;
        indices[idxBase+2u] = vertBase + 2u;
        indices[idxBase+3u] = vertBase;
        indices[idxBase+4u] = vertBase + 2u;
        indices[idxBase+5u] = vertBase + 3u;
    }
}
